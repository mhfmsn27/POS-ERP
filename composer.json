{
    "name": "poshub/poshub-accounting",
    "type": "project",
    "description": "POSHUB ACCOUNTING - Enterprise ERP & Omnichannel Point of Sale Platform",
    "keywords": ["poshub", "accounting", "erp", "pos", "omnichannel", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "ahmedsaoud31/laravel-permission-to-vuejs": "dev-master",
        "barryvdh/laravel-dompdf": "^0.9.0",
        "charlieuki/receiptprinter": "^1.2",
        "doctrine/dbal": "^3.3",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.5", 
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^8.12",
        "laravel/sanctum": "^2.15",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.2",
        "laravolt/avatar": "^5.0",
        "maatwebsite/excel": "^3.1",
        "mdhpos/licensekey": "dev-master",
        "mews/purifier": "^3.3",
        "midtrans/midtrans-php": "^2.5",
        "milon/barcode": "^8.0",
        "rachidlaasri/laravel-installer": "^4.1",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-permission": "^4.2",
        "spatie/laravel-sluggable": "^3.5",
        "yajra/laravel-datatables-oracle": "^9.19"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Poshub\\Ecommerce\\": "packages/poshub/ecommerce/src",
            "Mdhpos\\Ecommerce\\": "packages/poshub/ecommerce/src"
        },
        "files": ["app/Currency.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "treeware/plant": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
