APP_NAME="POSHUB ACCOUNTING"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=error
APP_URL=https://yourdomain.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poshub_accounting
DB_USERNAME=poshub_user
DB_PASSWORD=your_secure_password
DB_STRICT=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# MIDTRANS PAYMENT GATEWAY
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=

# RAJAONGKIR EXPEDITION API
RAJAONGKIR_API_KEY=
RAJAONGKIR_TYPE=pro

# CRMHUB OMNICHANNEL WA GATEWAY
CRMHUB_OMNICHANNEL_URL=http://127.0.0.1:8000/api/whatsapp/send
CRMHUB_API_TOKEN=
CRMHUB_OWNER_PHONE=

# ==========================================
# ENTERPRISE DOMAIN-LOCKED LICENSE SYSTEM
# ==========================================
# Google Sheets ID untuk validasi lisensi domain terpusat (Kolom: Domain, License Key, Client Name)
# Format URL: https://docs.google.com/spreadsheets/d/{LICENSE_SHEET_ID}/edit
LICENSE_SHEET_ID=

# Izinkan semua domain tanpa verifikasi Google Sheet (Gunakan true hanya untuk dev lokal)
ALLOW_ALL_LICENSE=false

# Durasi Cache Lisensi Lokal dalam Detik (Default: 21600 = 6 Jam)
LICENSE_CACHE_TTL=21600

# Masa Tenggang Offline Kasir / Grace Period dalam Detik (Default: 604800 = 7 Hari)
LICENSE_OFFLINE_GRACE_PERIOD=604800